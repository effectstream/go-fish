module Hand {
import CompactStandardLibrary;
import CompactStandardLibrary prefix std_;

// import './HashPersistent' prefix h_;
import './HashTransient' prefix h_;

// V4: Nested per-game Map so cleanupGame can drop all cards for a game in one
// `remove(gid)` call — no more gid-mixed keys leaking into a shared top-level map.
// Inner key is just h_hashCurvePoint(card); outer key is gid.
// Value is the owner's player id (1 or 2; 0 = removed — we keep the sentinel
// pattern to preserve the existing "card was here once" semantics used by the
// double-insert-during-transfer branch safety).
export ledger cardOwnership: Map<Bytes<32>, Map<Bytes<32>, Uint<8>>>;

// Hand sizes per game per player (already gid-keyed).
export ledger handSize1: Map<Bytes<32>, Uint<64>>;
export ledger handSize2: Map<Bytes<32>, Uint<64>>;

export circuit init_hands(gameId: Bytes<32>): [] {
    const gid = disclose(gameId);
    handSize1.insert(gid, 0 as Uint<64>);
    handSize2.insert(gid, 0 as Uint<64>);
    // Initialize the nested cardOwnership Map for this game.
    cardOwnership.insert(gid, default<Map<Bytes<32>, Uint<8>>>);
    return [];
}

// V4: Cleanup — drop everything this module owns for a game. Single remove per
// outer map; the nested cardOwnership map goes away entirely along with every
// card entry for this game.
export circuit clearGameState(gameId: Bytes<32>): [] {
    const gid = disclose(gameId);
    if (cardOwnership.member(gid)) { cardOwnership.remove(gid); }
    if (handSize1.member(gid))     { handSize1.remove(gid); }
    if (handSize2.member(gid))     { handSize2.remove(gid); }
    return [];
}

// Get current hand size
export circuit getHandSize(gameId: Bytes<32>, playerId: Uint<64>): Uint<64> {
    const gid = disclose(gameId);
    if (playerId == 1 as Uint<64>) {
        if (handSize1.member(gid)) {
            return handSize1.lookup(gid) as Uint<64>;
        }
        return 0 as Uint<64>;
    } else if (playerId == 2 as Uint<64>) {
        if (handSize2.member(gid)) {
            return handSize2.lookup(gid) as Uint<64>;
        }
        return 0 as Uint<64>;
    } else {
        assert(false, "Invalid player index");
    }
    return 0 as Uint<64>;
}

// Cards in players hands are semi-masked (masked with own secret) or in raw
// base-card form (received via transfer, per OPT-H).
export circuit removeCardFromHand(gameId: Bytes<32>, playerId: Uint<64>, semiMaskedPoint: JubjubPoint): JubjubPoint {
    const gid = disclose(gameId);
    const cardHash = h_hashCurvePoint(disclose(semiMaskedPoint));

    if (playerId == 1 as Uint<64>) {
        assert(cardOwnership.lookup(gid).member(disclose(cardHash)), "Card not in any hand");
        const owner = cardOwnership.lookup(gid).lookup(disclose(cardHash)) as Uint<8>;
        assert(owner == 1 as Uint<8>, "Card not in player 1 hand");
        cardOwnership.lookup(gid).insert(disclose(cardHash), 0 as Uint<8>);
        const currentSize = handSize1.lookup(gid) as Uint<64>;
        handSize1.insert(gid, currentSize - 1 as Uint<64>);
        return semiMaskedPoint;
    } else if (playerId == 2 as Uint<64>) {
        assert(cardOwnership.lookup(gid).member(disclose(cardHash)), "Card not in any hand");
        const owner = cardOwnership.lookup(gid).lookup(disclose(cardHash)) as Uint<8>;
        assert(owner == 2 as Uint<8>, "Card not in player 2 hand");
        cardOwnership.lookup(gid).insert(disclose(cardHash), 0 as Uint<8>);
        const currentSize = handSize2.lookup(gid) as Uint<64>;
        handSize2.insert(gid, currentSize - 1 as Uint<64>);
        return semiMaskedPoint;
    }
    assert(false, "Invalid player index");
    return semiMaskedPoint;
}

export circuit insertCardIntoHand(gameId: Bytes<32>, playerId: Uint<64>, card: JubjubPoint): [] {
    const gid = disclose(gameId);
    const cardHash = h_hashCurvePoint(disclose(card));

    if (playerId == 1 as Uint<64>) {
        cardOwnership.lookup(gid).insert(disclose(cardHash), 1 as Uint<8>);
        const currentSize = handSize1.lookup(gid) as Uint<64>;
        handSize1.insert(gid, currentSize + 1 as Uint<64>);
    } else if (playerId == 2 as Uint<64>) {
        cardOwnership.lookup(gid).insert(disclose(cardHash), 2 as Uint<8>);
        const currentSize = handSize2.lookup(gid) as Uint<64>;
        handSize2.insert(gid, currentSize + 1 as Uint<64>);
    } else {
        assert(false, "Invalid player index");
    }
    return [];
}

// Remove card without decrementing counter (for book removal)
export circuit removeCardFromHandForBook(gameId: Bytes<32>, playerId: Uint<64>, semiMaskedPoint: JubjubPoint): [] {
    const gid = disclose(gameId);
    const cardHash = h_hashCurvePoint(disclose(semiMaskedPoint));

    if (playerId == 1 as Uint<64>) {
        assert(cardOwnership.lookup(gid).member(disclose(cardHash)), "Card not in any hand");
        const owner = cardOwnership.lookup(gid).lookup(disclose(cardHash)) as Uint<8>;
        assert(owner == 1 as Uint<8>, "Card not in player 1 hand");
        cardOwnership.lookup(gid).insert(disclose(cardHash), 0 as Uint<8>);
        const currentSize = handSize1.lookup(gid) as Uint<64>;
        handSize1.insert(gid, currentSize - 1 as Uint<64>);
    } else if (playerId == 2 as Uint<64>) {
        assert(cardOwnership.lookup(gid).member(disclose(cardHash)), "Card not in any hand");
        const owner = cardOwnership.lookup(gid).lookup(disclose(cardHash)) as Uint<8>;
        assert(owner == 2 as Uint<8>, "Card not in player 2 hand");
        cardOwnership.lookup(gid).insert(disclose(cardHash), 0 as Uint<8>);
        const currentSize = handSize2.lookup(gid) as Uint<64>;
        handSize2.insert(gid, currentSize - 1 as Uint<64>);
    } else {
        assert(false, "Invalid player index");
    }
    return [];
}

export circuit doesPlayerHaveCard(gameId: Bytes<32>, playerId: Uint<64>, card: JubjubPoint): Boolean {
    const gid = disclose(gameId);
    const cardHash = h_hashCurvePoint(disclose(card));

    if (!cardOwnership.lookup(gid).member(disclose(cardHash))) {
        return false;
    }

    const owner = cardOwnership.lookup(gid).lookup(disclose(cardHash)) as Uint<8>;

    if (playerId == 1 as Uint<64>) {
        return owner == 1 as Uint<8>;
    } else if (playerId == 2 as Uint<64>) {
        return owner == 2 as Uint<8>;
    }
    assert(false, "Invalid player index");
    return false;
}

export circuit doesPlayerHaveCardN(gameId: Bytes<32>, playerId: Uint<64>, card: JubjubPoint): Uint<8> {
    const gid = disclose(gameId);
    const cardHash = h_hashCurvePoint(disclose(card));

    if (!cardOwnership.lookup(gid).member(disclose(cardHash))) {
        return 0 as Uint<8>;
    }

    const owner = cardOwnership.lookup(gid).lookup(disclose(cardHash)) as Uint<8>;

    if (playerId == 1 as Uint<64>) {
        return owner == 1 as Uint<8> ? 1 as Uint<8> : 0 as Uint<8>;
    } else if (playerId == 2 as Uint<64>) {
        return owner == 2 as Uint<8> ? 1 as Uint<8> : 0 as Uint<8>;
    }
    assert(false, "Invalid player index");
    return 0 as Uint<8>;
}

}
