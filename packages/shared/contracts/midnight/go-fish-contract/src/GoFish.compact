module GoFish {
import CompactStandardLibrary;
import './HashTransient' prefix h_;

// V4.1: Admin's private secret. The ADMIN knows the value; the contract never
// sees it in the clear — only its hash is stored in `owner`. Every admin-only
// circuit re-derives this hash from the witness and compares to the stored
// value. Injecting a different value via the witness just yields a different
// hash, so the comparison fails. `ownPublicKey()` is NOT safe here — it's an
// un-verified witness with no cryptographic binding.
witness admin_secret_key(): Field;

export enum GamePhase {
    Setup,
    TurnStart,
    WaitForResponse,
    WaitForTransfer,
    WaitForDraw,          // V3.3: active — requestToDrawCard sets this, drawCard clears it (empty-hand player asked opponent to draw from deck)
    WaitForDrawCheck,
    GameOver
}

// Game registry - tracks which games exist
export ledger gameExists: Map<Bytes<32>, Boolean>;

// All game state wrapped in Map<gameId, ...>
export ledger currentTurn: Map<Bytes<32>, Uint<64>>; // 1 or 2
export ledger phase: Map<Bytes<32>, GamePhase>;
export ledger scoreP1: Map<Bytes<32>, Uint<8>>;
export ledger scoreP2: Map<Bytes<32>, Uint<8>>;
// Per-player booked ranks. Nested Set<Uint<8>> — rank values 0..6 inserted on book. Game ends at 4 books, so at most 4 entries per set.
export ledger booksP1: Map<Bytes<32>, Set<Uint<8>>>;
export ledger booksP2: Map<Bytes<32>, Set<Uint<8>>>;
// Tracks whether each player has completed their one-time post-deal initial book scan.
// askForCard asserts both flags are true. Parallel-safe: each player only writes their own.
export ledger initialBooksScoredP1: Map<Bytes<32>, Boolean>;
export ledger initialBooksScoredP2: Map<Bytes<32>, Boolean>;
export ledger cardsDealtP1: Map<Bytes<32>, Uint<64>>; // Track cards dealt during setup
export ledger cardsDealtP2: Map<Bytes<32>, Uint<64>>;
export ledger lastAskedRank: Map<Bytes<32>, Uint<32>>; // Track the rank being asked for (for state recovery)
export ledger lastAskingPlayer: Map<Bytes<32>, Uint<64>>; // Track who is asking for cards
export ledger maskAppliedP1: Map<Bytes<32>, Boolean>; // Track if player 1 applied mask
export ledger maskAppliedP2: Map<Bytes<32>, Boolean>; // Track if player 2 applied mask
export ledger preDrawRankCount: Map<Bytes<32>, Uint<8>>;
export ledger hasDealtP1: Map<Bytes<32>, Boolean>; // Track if player 1 has called dealCards
export ledger hasDealtP2: Map<Bytes<32>, Boolean>; // Track if player 2 has called dealCards
export ledger lastMoveAt: Map<Bytes<32>, Uint<64>>; // Block timestamp of the last move (for timeout)
export ledger lastDrawnCard: Map<Bytes<32>, JubjubPoint>; // V3: Drawn card point (set by respondToAsk, verified by afterGoFish)
export ledger winner: Map<Bytes<32>, Uint<64>>; // V4: Winner of game (0=none/tie, 1=P1, 2=P2)

// Player authentication — binds playerId to h_hashField(player_secret_key).
// V4.1: value is the SECRET HASH, not a wallet pubkey. Auth proves the caller
// knows the secret that hashes to this value; injecting a different witness
// yields a different hash and the check fails.
export ledger playerPubKey1: Map<Bytes<32>, Bytes<32>>; // gameId → P1 secret hash
export ledger playerPubKey2: Map<Bytes<32>, Bytes<32>>; // gameId → P2 secret hash

// V4.1: Contract owner = h_hashField(admin_secret_key()). Never stores a
// wallet pubkey. Initialized once via `initialize()` — subsequent owner
// circuits re-derive from the witness and compare.
ledger owner: Bytes<32>;
ledger ownerInitialized: Boolean;

// One-shot owner initialization. The first caller with a non-zero admin
// secret becomes owner. Admin secret is provided via the witness
// `admin_secret_key` — every owner-only circuit re-derives the hash and
// compares, so swapping the witness value after-the-fact just fails auth.
export circuit initialize(): [] {
    assert(!ownerInitialized, "Owner already initialized");
    const secret = admin_secret_key();
    owner = h_hashField(disclose(secret));
    ownerInitialized = true;
    return [];
}

// True iff the caller supplies the admin secret whose hash matches the
// stored `owner`. Any other witness value produces a different hash.
export circuit isOwner(): Boolean {
    if (!ownerInitialized) { return false; }
    const secret = admin_secret_key();
    const hash = h_hashField(disclose(secret));
    return hash == owner;
}

// Gate for privileged operations. Reverts unless the caller's witness-derived
// hash equals the stored owner hash.
export circuit assertCallerIsOwner(): [] {
    assert(ownerInitialized, "No owner set — call initialize first");
    const secret = admin_secret_key();
    const hash = h_hashField(disclose(secret));
    assert(hash == owner, "Only owner can perform this action");
    return [];
}

// Public getter — returns the stored owner hash (reverts if uninitialized).
// Frontends compare against a locally-derived hash of the admin secret to
// show/hide admin UI.
export circuit getOwner(): Bytes<32> {
    assert(ownerInitialized, "No owner set");
    return owner;
}

// V4: Cleanup — drop everything this module owns for a game. Single remove per
// directly-gid-keyed map. All entries go away.
export circuit clearGameState(gameId: Bytes<32>): [] {
    const gid = disclose(gameId);
    if (gameExists.member(gid))              { gameExists.remove(gid); }
    if (currentTurn.member(gid))             { currentTurn.remove(gid); }
    if (phase.member(gid))                   { phase.remove(gid); }
    if (scoreP1.member(gid))                 { scoreP1.remove(gid); }
    if (scoreP2.member(gid))                 { scoreP2.remove(gid); }
    if (booksP1.member(gid))                 { booksP1.remove(gid); }
    if (booksP2.member(gid))                 { booksP2.remove(gid); }
    if (initialBooksScoredP1.member(gid))    { initialBooksScoredP1.remove(gid); }
    if (initialBooksScoredP2.member(gid))    { initialBooksScoredP2.remove(gid); }
    if (cardsDealtP1.member(gid))            { cardsDealtP1.remove(gid); }
    if (cardsDealtP2.member(gid))            { cardsDealtP2.remove(gid); }
    if (lastAskedRank.member(gid))           { lastAskedRank.remove(gid); }
    if (lastAskingPlayer.member(gid))        { lastAskingPlayer.remove(gid); }
    if (maskAppliedP1.member(gid))           { maskAppliedP1.remove(gid); }
    if (maskAppliedP2.member(gid))           { maskAppliedP2.remove(gid); }
    if (preDrawRankCount.member(gid))        { preDrawRankCount.remove(gid); }
    if (hasDealtP1.member(gid))              { hasDealtP1.remove(gid); }
    if (hasDealtP2.member(gid))              { hasDealtP2.remove(gid); }
    if (lastMoveAt.member(gid))              { lastMoveAt.remove(gid); }
    if (lastDrawnCard.member(gid))           { lastDrawnCard.remove(gid); }
    if (winner.member(gid))                  { winner.remove(gid); }
    if (playerPubKey1.member(gid))           { playerPubKey1.remove(gid); }
    if (playerPubKey2.member(gid))           { playerPubKey2.remove(gid); }
    return [];
}

// Register the caller's public key for a player slot. Called during applyMask (first move).
// playerId must already be disclosed by the caller.
// V4.1: Register a player slot with a caller-provided secret hash.
// Caller must supply the hash of THEIR own player_secret_key (derived via
// `deck_getSecretHashForPlayer(gid, pid)` in the composition layer — that
// circuit itself depends on the witness, so the hash is sourced from whatever
// secret the caller actually knows). Anyone registering with an attacker's
// hash forfeits the slot to the attacker, but the attacker still needs the
// matching secret to authenticate later moves.
export circuit setPlayerHash(gameId: Bytes<32>, playerId: Uint<64>, secretHash: Bytes<32>): [] {
    const gid = disclose(gameId);
    const pid = disclose(playerId);
    const h = disclose(secretHash);
    if (pid == 1 as Uint<64>) {
        assert(!playerPubKey1.member(gid), "Player 1 already registered");
        playerPubKey1.insert(gid, h);
    } else if (pid == 2 as Uint<64>) {
        assert(!playerPubKey2.member(gid), "Player 2 already registered");
        playerPubKey2.insert(gid, h);
    } else {
        assert(false, "Invalid player index");
    }
    return [];
}

// V4.1: Verify the caller is the registered player for `playerId` by comparing
// the caller's freshly-derived secret hash against the stored one.
// The composition-layer helper derives `secretHash` via the caller's own
// witness; the comparison in-circuit is cryptographically sound: without the
// registered secret you cannot produce the matching hash.
export circuit assertPlayerHash(gameId: Bytes<32>, playerId: Uint<64>, secretHash: Bytes<32>): [] {
    const gid = disclose(gameId);
    const pid = disclose(playerId);
    const h = disclose(secretHash);

    if (pid == 1 as Uint<64>) {
        assert(playerPubKey1.member(gid), "Player 1 not registered");
        const expected = playerPubKey1.lookup(gid) as Bytes<32>;
        assert(h == expected, "Caller is not player 1");
    } else if (pid == 2 as Uint<64>) {
        assert(playerPubKey2.member(gid), "Player 2 not registered");
        const expected = playerPubKey2.lookup(gid) as Bytes<32>;
        assert(h == expected, "Caller is not player 2");
    } else {
        assert(false, "Invalid player index");
    }
    return [];
}

// V4.1: Check if the provided secret hash matches a registered player.
// Returns the playerId (1 or 2) if registered, or 0 if not a known player.
// Used by cleanupGame to determine if a non-owner caller is a game participant.
export circuit resolvePlayerFromHash(gameId: Bytes<32>, secretHash: Bytes<32>): Uint<64> {
    const gid = disclose(gameId);
    const h = disclose(secretHash);
    if (playerPubKey1.member(gid)) {
        const p1 = playerPubKey1.lookup(gid) as Bytes<32>;
        if (h == p1) { return 1 as Uint<64>; }
    }
    if (playerPubKey2.member(gid)) {
        const p2 = playerPubKey2.lookup(gid) as Bytes<32>;
        if (h == p2) { return 2 as Uint<64>; }
    }
    return 0 as Uint<64>;
}

// Initialize a new game with the given gameId
export circuit init_game(gameId: Bytes<32>): [] {
    const gid = disclose(gameId);
    assert(!gameExists.member(gid), "Game already exists");
    
    gameExists.insert(gid, true);
    currentTurn.insert(gid, 1 as Uint<64>);
    phase.insert(gid, GamePhase.Setup);
    scoreP1.insert(gid, 0 as Uint<8>);
    scoreP2.insert(gid, 0 as Uint<8>);
    booksP1.insert(gid, default<Set<Uint<8>>>);
    booksP2.insert(gid, default<Set<Uint<8>>>);
    initialBooksScoredP1.insert(gid, false);
    initialBooksScoredP2.insert(gid, false);
    cardsDealtP1.insert(gid, 0 as Uint<64>);
    cardsDealtP2.insert(gid, 0 as Uint<64>);
    lastAskedRank.insert(gid, 255 as Uint<32>); // 255 = no pending request
    lastAskingPlayer.insert(gid, 0 as Uint<64>); // 0 = no pending request
    preDrawRankCount.insert(gid, 0 as Uint<8>);
    maskAppliedP1.insert(gid, false);
    maskAppliedP2.insert(gid, false);
    hasDealtP1.insert(gid, false);
    hasDealtP2.insert(gid, false);
    lastMoveAt.insert(gid, 0 as Uint<64>);
    return [];
}

// Check if a game exists
export circuit doesGameExist(gameId: Bytes<32>): Boolean {
    return gameExists.member(disclose(gameId));
}

// Switch turns between players
export circuit switchTurn(gameId: Bytes<32>): [] {
    const gid = disclose(gameId);
    assert(gameExists.member(gid), "Game does not exist");
    
    const turn = currentTurn.lookup(gid) as Uint<64>;
    if (turn == 1 as Uint<64>) {
        currentTurn.insert(gid, 2 as Uint<64>);
    } else {
        currentTurn.insert(gid, 1 as Uint<64>);
    }
    phase.insert(gid, GamePhase.TurnStart);
    return [];
}

// Set game phase
export circuit setPhase(gameId: Bytes<32>, newPhase: GamePhase): [] {
    const gid = disclose(gameId);
    assert(gameExists.member(gid), "Game does not exist");
    phase.insert(gid, disclose(newPhase));
    return [];
}

// Add score for a player making a book
export circuit addScore(gameId: Bytes<32>, playerId: Uint<64>): [] {
    const gid = disclose(gameId);
    const disclosed_playerId = disclose(playerId);
    assert(gameExists.member(gid), "Game does not exist");

    // Read pre-increment scores ONCE, compute post-increment values
    // locally, then write. Do NOT re-read scoreP1/scoreP2 after the
    // insert — Compact's queryLedgerState mutates the circuit context
    // in place, so a re-read returns the POST-write value, and a
    // naive `s + 1` would double-count. Using newS1/newS2 directly
    // avoids any dependency on ledger read-after-write semantics.
    const prevS1 = scoreP1.lookup(gid) as Uint<8>;
    const prevS2 = scoreP2.lookup(gid) as Uint<8>;
    const newS1: Uint<8> = (disclosed_playerId == 1 as Uint<64>)
        ? (prevS1 + 1 as Uint<8>) as Uint<8>
        : prevS1;
    const newS2: Uint<8> = (disclosed_playerId == 2 as Uint<64>)
        ? (prevS2 + 1 as Uint<8>) as Uint<8>
        : prevS2;

    if (disclosed_playerId == 1 as Uint<64>) {
        scoreP1.insert(gid, newS1);
    } else if (disclosed_playerId == 2 as Uint<64>) {
        scoreP2.insert(gid, newS2);
    }

    // Early-win at majority threshold (≥ 4 books of 7). Supersedes the
    // old "books + 1 == 7" cap — by pigeonhole, 7 books implies max
    // score ≥ 4, so this check fires strictly earlier. No tie branch:
    // by induction, when this fires the other player is strictly < 4.
    if (newS1 >= 4 as Uint<8>) {
        phase.insert(gid, GamePhase.GameOver);
        winner.insert(gid, 1 as Uint<64>);
    } else if (newS2 >= 4 as Uint<8>) {
        phase.insert(gid, GamePhase.GameOver);
        winner.insert(gid, 2 as Uint<64>);
    }
    return [];
}

// Mark a rank as booked for a player — inserts into the per-player Set.
// Idempotent (Set.insert on existing element is a no-op).
export circuit markRankBooked(gameId: Bytes<32>, playerId: Uint<64>, rank: Uint<8>): [] {
    const gid = disclose(gameId);
    const disclosed_playerId = disclose(playerId);
    const disclosed_rank = disclose(rank);
    assert(gameExists.member(gid), "Game does not exist");
    if (disclosed_playerId == 1 as Uint<64>) {
        booksP1.lookup(gid).insert(disclosed_rank);
    } else if (disclosed_playerId == 2 as Uint<64>) {
        booksP2.lookup(gid).insert(disclosed_rank);
    }
    return [];
}

// Check if a rank has been booked by a player.
export circuit isRankBooked(gameId: Bytes<32>, playerId: Uint<64>, rank: Uint<8>): Boolean {
    const gid = disclose(gameId);
    const disclosed_playerId = disclose(playerId);
    const disclosed_rank = disclose(rank);
    assert(gameExists.member(gid), "Game does not exist");
    if (disclosed_playerId == 1 as Uint<64>) {
        return booksP1.lookup(gid).member(disclosed_rank);
    } else if (disclosed_playerId == 2 as Uint<64>) {
        return booksP2.lookup(gid).member(disclosed_rank);
    }
    return false;
}

// Mark that a player has completed their post-deal initial book scan.
export circuit markInitialBooksScored(gameId: Bytes<32>, playerId: Uint<64>): [] {
    const gid = disclose(gameId);
    const disclosed_playerId = disclose(playerId);
    assert(gameExists.member(gid), "Game does not exist");
    if (disclosed_playerId == 1 as Uint<64>) {
        initialBooksScoredP1.insert(gid, true);
    } else if (disclosed_playerId == 2 as Uint<64>) {
        initialBooksScoredP2.insert(gid, true);
    }
    return [];
}

// Query whether a player has completed initial book scan.
export circuit hasInitialBooksScored(gameId: Bytes<32>, playerId: Uint<64>): Boolean {
    const gid = disclose(gameId);
    const disclosed_playerId = disclose(playerId);
    assert(gameExists.member(gid), "Game does not exist");
    if (disclosed_playerId == 1 as Uint<64>) {
        return initialBooksScoredP1.lookup(gid) as Boolean;
    } else if (disclosed_playerId == 2 as Uint<64>) {
        return initialBooksScoredP2.lookup(gid) as Boolean;
    }
    return false;
}

// Mark that a card was dealt during setup
export circuit markCardDealt(gameId: Bytes<32>, playerId: Uint<64>): [] {
    const gid = disclose(gameId);
    const disclosed_playerId = disclose(playerId);
    assert(gameExists.member(gid), "Game does not exist");
    
    if (disclosed_playerId == 1 as Uint<64>) {
        const current = cardsDealtP1.lookup(gid) as Uint<64>;
        cardsDealtP1.insert(gid, current + 1 as Uint<64>);
    } else if (disclosed_playerId == 2 as Uint<64>) {
        const current = cardsDealtP2.lookup(gid) as Uint<64>;
        cardsDealtP2.insert(gid, current + 1 as Uint<64>);
    }
    return [];
}

// Check if initial dealing is complete (4 cards each for 2 players)
// CHANGED: 4 Cards
export circuit isDealingComplete(gameId: Bytes<32>): Boolean {
    const gid = disclose(gameId);
    assert(gameExists.member(gid), "Game does not exist");
    
    const p1Cards = cardsDealtP1.lookup(gid) as Uint<64>;
    const p2Cards = cardsDealtP2.lookup(gid) as Uint<64>;
    return p1Cards >= 4 as Uint<64> && p2Cards >= 4 as Uint<64>;
}

// Transition from Setup to TurnStart once dealing is done
export circuit startGame(gameId: Bytes<32>): [] {
    const gid = disclose(gameId);
    assert(gameExists.member(gid), "Game does not exist");
    
    const currentPhase = phase.lookup(gid) as GamePhase;
    assert(currentPhase == GamePhase.Setup, "Game not in setup phase");
    assert(isDealingComplete(gid), "Cards not yet dealt to both players");
    phase.insert(gid, GamePhase.TurnStart);
    return [];
}

// Check if it's game over
export circuit isGameOver(gameId: Bytes<32>): Boolean {
    const gid = disclose(gameId);
    assert(gameExists.member(gid), "Game does not exist");
    
    const currentPhase = phase.lookup(gid) as GamePhase;
    return currentPhase == GamePhase.GameOver;
}

// Get current player's turn
export circuit getCurrentTurn(gameId: Bytes<32>): Uint<64> {
    const gid = disclose(gameId);
    assert(gameExists.member(gid), "Game does not exist");
    return currentTurn.lookup(gid) as Uint<64>;
}

// Get current phase
export circuit getPhase(gameId: Bytes<32>): GamePhase {
    const gid = disclose(gameId);
    assert(gameExists.member(gid), "Game does not exist");
    return phase.lookup(gid) as GamePhase;
}

// End game (when deck empty and a player has no cards)
export circuit endGame(gameId: Bytes<32>): [] {
    const gid = disclose(gameId);
    assert(gameExists.member(gid), "Game does not exist");
    phase.insert(gid, GamePhase.GameOver);
    // V4: No specific winner (e.g., checkAndEndGame — both hands empty)
    // Determine by score
    const s1 = scoreP1.lookup(gid) as Uint<8>;
    const s2 = scoreP2.lookup(gid) as Uint<8>;
    if (s1 > s2) { winner.insert(gid, 1 as Uint<64>); }
    else if (s2 > s1) { winner.insert(gid, 2 as Uint<64>); }
    else { winner.insert(gid, 0 as Uint<64>); }
    return [];
}

// V4: End game with a specific winner (used by claimTimeoutWin)
export circuit endGameWithWinner(gameId: Bytes<32>, winnerId: Uint<64>): [] {
    const gid = disclose(gameId);
    assert(gameExists.member(gid), "Game does not exist");
    phase.insert(gid, GamePhase.GameOver);
    winner.insert(gid, disclose(winnerId));
    return [];
}

// V4: Get winner
export circuit getWinner(gameId: Bytes<32>): Uint<64> {
    const gid = disclose(gameId);
    assert(gameExists.member(gid), "Game does not exist");
    if (winner.member(gid)) {
        return winner.lookup(gid) as Uint<64>;
    }
    return 0 as Uint<64>;
}

// Set the last asked rank (called by askForCard)
export circuit setLastAskedRank(gameId: Bytes<32>, rank: Uint<32>): [] {
    const gid = disclose(gameId);
    assert(gameExists.member(gid), "Game does not exist");
    lastAskedRank.insert(gid, disclose(rank));
    return [];
}

// Set the asking player ID (called by askForCard)
export circuit setLastAskingPlayer(gameId: Bytes<32>, playerId: Uint<64>): [] {
    const gid = disclose(gameId);
    assert(gameExists.member(gid), "Game does not exist");
    lastAskingPlayer.insert(gid, disclose(playerId));
    return [];
}

// Clear the last asked rank and player (called after response)
export circuit clearLastAskedRank(gameId: Bytes<32>): [] {
    const gid = disclose(gameId);
    assert(gameExists.member(gid), "Game does not exist");
    lastAskedRank.insert(gid, 255 as Uint<32>);
    lastAskingPlayer.insert(gid, 0 as Uint<64>);
    return [];
}

// Get the last asked rank (for state recovery)
export circuit getLastAskedRank(gameId: Bytes<32>): Uint<32> {
    const gid = disclose(gameId);
    assert(gameExists.member(gid), "Game does not exist");
    return lastAskedRank.lookup(gid) as Uint<32>;
}

// Get the last asking player (for response processing)
export circuit getLastAskingPlayer(gameId: Bytes<32>): Uint<64> {
    const gid = disclose(gameId);
    assert(gameExists.member(gid), "Game does not exist");
    return lastAskingPlayer.lookup(gid) as Uint<64>;
}

// Mark that a player has applied their mask
export circuit markMaskApplied(gameId: Bytes<32>, playerId: Uint<64>): [] {
    const gid = disclose(gameId);
    const disclosed_playerId = disclose(playerId);
    assert(gameExists.member(gid), "Game does not exist");
    
    if (disclosed_playerId == 1 as Uint<64>) {
        maskAppliedP1.insert(gid, true);
    } else if (disclosed_playerId == 2 as Uint<64>) {
        maskAppliedP2.insert(gid, true);
    }
    return [];
}

// Check if a player has applied their mask
export circuit hasMaskApplied(gameId: Bytes<32>, playerId: Uint<64>): Boolean {
    const gid = disclose(gameId);
    const disclosed_playerId = disclose(playerId);
    assert(gameExists.member(gid), "Game does not exist");
    
    if (disclosed_playerId == 1 as Uint<64>) {
        return maskAppliedP1.lookup(gid) as Boolean;
    } else if (disclosed_playerId == 2 as Uint<64>) {
        return maskAppliedP2.lookup(gid) as Boolean;
    }
    return false;
}

// Get the number of cards dealt to a player (for state recovery)
export circuit getCardsDealt(gameId: Bytes<32>, playerId: Uint<64>): Uint<64> {
    const gid = disclose(gameId);
    const disclosed_playerId = disclose(playerId);
    assert(gameExists.member(gid), "Game does not exist");
    
    if (disclosed_playerId == 1 as Uint<64>) {
        return cardsDealtP1.lookup(gid) as Uint<64>;
    } else if (disclosed_playerId == 2 as Uint<64>) {
        return cardsDealtP2.lookup(gid) as Uint<64>;
    }
    return 0 as Uint<64>;
}

// Setter for the pre-draw count
export circuit setPreDrawRankCount(gameId: Bytes<32>, count: Uint<8>): [] {
    const gid = disclose(gameId);
    assert(gameExists.member(gid), "Game does not exist");
    preDrawRankCount.insert(gid, disclose(count));
    return [];
}

// Getter for the pre-draw count
export circuit getPreDrawRankCount(gameId: Bytes<32>): Uint<8> {
    const gid = disclose(gameId);
    assert(gameExists.member(gid), "Game does not exist");
    return preDrawRankCount.lookup(gid) as Uint<8>;
}

// Mark that a player has dealt cards
export circuit markHasDealt(gameId: Bytes<32>, playerId: Uint<64>): [] {
    const gid = disclose(gameId);
    const disclosed_playerId = disclose(playerId);
    assert(gameExists.member(gid), "Game does not exist");
    
    if (disclosed_playerId == 1 as Uint<64>) {
        hasDealtP1.insert(gid, true);
    } else if (disclosed_playerId == 2 as Uint<64>) {
        hasDealtP2.insert(gid, true);
    }
    return [];
}

// Check if a player has dealt cards
export circuit hasDealt(gameId: Bytes<32>, playerId: Uint<64>): Boolean {
    const gid = disclose(gameId);
    const disclosed_playerId = disclose(playerId);
    assert(gameExists.member(gid), "Game does not exist");
    
    if (disclosed_playerId == 1 as Uint<64>) {
        return hasDealtP1.lookup(gid) as Boolean;
    } else if (disclosed_playerId == 2 as Uint<64>) {
        return hasDealtP2.lookup(gid) as Boolean;
    }
    return false;
}

// Get how many players have dealt (0, 1, or 2)
export circuit getPlayersDealtCount(gameId: Bytes<32>): Uint<8> {
    const gid = disclose(gameId);
    assert(gameExists.member(gid), "Game does not exist");
    
    const p1Dealt = hasDealtP1.lookup(gid) as Boolean;
    const p2Dealt = hasDealtP2.lookup(gid) as Boolean;
    const p1: Uint<8> = p1Dealt ? 1 as Uint<8> : 0 as Uint<8>;
    const p2: Uint<8> = p2Dealt ? 1 as Uint<8> : 0 as Uint<8>;
    return (p1 + p2) as Uint<8>;
}

// Get scores for a game
export circuit getScores(gameId: Bytes<32>): [Uint<8>, Uint<8>] {
    const gid = disclose(gameId);
    assert(gameExists.member(gid), "Game does not exist");

    const s1 = scoreP1.lookup(gid) as Uint<8>;
    const s2 = scoreP2.lookup(gid) as Uint<8>;
    return [s1, s2];
}

// Record the timestamp of the most recent move.
// Called from every game-progressing circuit (askForCard, respondToAsk, goFish, afterGoFish).
// V3: Store the drawn card point (set by respondToAsk when Go Fish occurs)
export circuit setLastDrawnCard(gameId: Bytes<32>, card: JubjubPoint): [] {
    const gid = disclose(gameId);
    assert(gameExists.member(gid), "Game does not exist");
    lastDrawnCard.insert(gid, disclose(card));
    return [];
}

// V3: Get the drawn card point
export circuit getLastDrawnCard(gameId: Bytes<32>): JubjubPoint {
    const gid = disclose(gameId);
    assert(gameExists.member(gid), "Game does not exist");
    return lastDrawnCard.lookup(gid) as JubjubPoint;
}

export circuit setLastMoveAt(gameId: Bytes<32>, now: Uint<64>): [] {
    const gid = disclose(gameId);
    assert(gameExists.member(gid), "Game does not exist");
    lastMoveAt.insert(gid, disclose(now));
    return [];
}

// Return the timestamp of the last recorded move.
export circuit getLastMoveAt(gameId: Bytes<32>): Uint<64> {
    const gid = disclose(gameId);
    assert(gameExists.member(gid), "Game does not exist");
    return lastMoveAt.lookup(gid) as Uint<64>;
}

// Return the turn timeout constant (exposed so off-chain code can read it).
// 300 seconds = 5 minutes per turn.
export circuit getTurnTimeout(): Uint<64> {
    return 300 as Uint<64>;
}

}