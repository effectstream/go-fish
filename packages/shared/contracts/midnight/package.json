{
  "name": "@go-fish/midnight-contracts",
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": "./go-fish-contract/src/_index.ts",
    "./witnesses": "./go-fish-contract/src/witnesses.ts",
    "./contract": "./go-fish-contract/src/managed/contract/index.js"
  },
  "scripts": {
    "contract:compile": "bun run --filter @go-fish/midnight-contract compact",
    "midnight-node:start": "CFG_PRESET=dev bun ./node_modules/.bin/npm-midnight-node --dev --rpc-port 9944 --state-pruning archive --blocks-pruning archive --public-addr /ip4/127.0.0.1 --unsafe-rpc-external",
    "midnight-node:wait": "wait-on tcp:9944",
    "midnight-indexer:start": "CONFIG_FILE=`pwd`/indexer-standalone/config.yaml LEDGER_NETWORK_ID=\"Undeployed\" SUBSTRATE_NODE_WS_URL=\"ws://localhost:9944\" APP__INFRA__SECRET=$(openssl rand -hex 32 | tr 'a-f' 'A-F') FEATURES_WALLET_ENABLED=\"true\" APP__INFRA__NODE__URL=\"ws://localhost:9944\" bun ./node_modules/.bin/npm-midnight-indexer --binary --clean",
    "midnight-indexer:wait": "wait-on tcp:8088",
    "midnight-proof-server:start": "LEDGER_NETWORK_ID=\"Undeployed\" RUST_BACKTRACE=full SUBSTRATE_NODE_WS_URL=\"ws://localhost:9944\" bun ./node_modules/.bin/npm-midnight-proof-server",
    "midnight-proof-server:wait": "wait-on tcp:6300",
    "midnight-contract:clean": "rm -rf midnight-level-db midnight-level-db-deploy && rm -f contract.json contract-go-fish.undeployed.json deployment-state.json",
    "midnight-contract:deploy": "bun run contract:compile && bun run midnight-contract:clean && bun run deploy.ts",
    "midnight-contract:deploy-quick": "bun run contract:compile && bun run midnight-contract:clean && MIDNIGHT_DEPLOY_VERIFIER_KEYS_LIMIT=1 bun run deploy.ts",
    "midnight-contract:initialize": "bun run contract-initialize.ts",
    "midnight-faucet:start": "bun run faucet.ts",
    "test": "bun run example.test.ts"
  },
  "dependencies": {
    "@effectstream/midnight-contracts": "0.100.26",
    "@effectstream/npm-midnight-indexer": "0.100.26",
    "@effectstream/npm-midnight-node": "0.100.26",
    "@effectstream/npm-midnight-proof-server": "0.100.26",
    "@midnight-ntwrk/compact-js": "2.5.0",
    "@midnight-ntwrk/compact-runtime": "0.15.0",
    "@midnight-ntwrk/ledger-v8": "8.0.3",
    "@midnight-ntwrk/midnight-js-contracts": "4.0.2",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "4.0.2",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "4.0.2",
    "@midnight-ntwrk/midnight-js-level-private-state-provider": "4.0.2",
    "@midnight-ntwrk/midnight-js-network-id": "4.0.2",
    "@midnight-ntwrk/midnight-js-node-zk-config-provider": "4.0.2",
    "@midnight-ntwrk/midnight-js-types": "4.0.2",
    "@midnight-ntwrk/midnight-js-utils": "4.0.2",
    "@midnight-ntwrk/onchain-runtime": "npm:@midnight-ntwrk/onchain-runtime-v3@3.0.0",
    "@midnight-ntwrk/wallet": "5.0.0",
    "@midnight-ntwrk/wallet-api": "5.0.0",
    "@midnight-ntwrk/wallet-sdk-abstractions": "2.0.0",
    "@midnight-ntwrk/wallet-sdk-address-format": "3.1.0",
    "@midnight-ntwrk/wallet-sdk-dust-wallet": "3.0.0",
    "@midnight-ntwrk/wallet-sdk-facade": "3.0.0",
    "@midnight-ntwrk/wallet-sdk-hd": "3.0.1",
    "@midnight-ntwrk/wallet-sdk-shielded": "2.1.0",
    "@midnight-ntwrk/wallet-sdk-unshielded-wallet": "2.1.0",
    "@midnight-ntwrk/zswap": "4.0.0",
    "rxjs": "^7.8.2"
  }
}
