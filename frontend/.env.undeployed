# Undeployed (local development) environment
# Used with: npm run dev:undeployed / npm run build:undeployed

VITE_BATCHER_MODE_ENABLED=true

# Paima node API URL (backend game engine)
VITE_NODE_API_URL=http://localhost:9996

# Paima batcher service URL (handles transaction submission)
VITE_BATCHER_URL=http://localhost:3336

# Batcher query server URL (on-chain game state queries)
VITE_BATCHER_QUERY_URL=http://localhost:9997

# Indexer URLs (for reading blockchain state)
VITE_INDEXER_HTTP_URL=http://127.0.0.1:8088/api/v3/graphql
VITE_INDEXER_WS_URL=ws://127.0.0.1:8088/api/v3/graphql/ws

# EVM RPC URL (local Hardhat)
VITE_EVM_RPC_URL=http://localhost:8545

# Paima L2 contract address (local Hardhat deployment)
VITE_PAIMA_L2_CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

# Midnight network ID
VITE_MIDNIGHT_NETWORK_ID=undeployed
