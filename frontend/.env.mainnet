# Mainnet environment
# Used with: npm run dev:mainnet / npm run build:mainnet

VITE_BATCHER_MODE_ENABLED=true

# Paima node API URL (deployed backend)
VITE_NODE_API_URL=https://api-gofish.midnight.fun

# Paima batcher service URL
VITE_BATCHER_URL=https://batcher-gofish.midnight.fun

# Batcher query server URL
VITE_BATCHER_QUERY_URL=https://batcher-gofish.midnight.fun

# Indexer URLs (Midnight mainnet)
VITE_INDEXER_HTTP_URL=https://indexer.mainnet.midnight.network/api/v3/graphql
VITE_INDEXER_WS_URL=wss://indexer.mainnet.midnight.network/api/v3/graphql/ws

# EVM RPC URL (Arbitrum mainnet)
VITE_EVM_RPC_URL=https://arb1.arbitrum.io/rpc

# Paima L2 contract address (Arbitrum deployment)
VITE_PAIMA_L2_CONTRACT_ADDRESS=0x198a658159D9c15972BE1AeeA3a60eF0c040b5F1

# Midnight network ID
VITE_MIDNIGHT_NETWORK_ID=mainnet
